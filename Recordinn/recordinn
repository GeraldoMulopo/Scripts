        # Botoes em baixo
        b_frame = ttk.Frame(top)
        b_frame.pack(fill="x", pady=(10, 0))

        self.btn_gravar = ttk.Button(b_frame, text="Gravar", style="Rec.TButton",
                                      command=self._toggle_gravar)
        self.btn_gravar.pack(side="left")
