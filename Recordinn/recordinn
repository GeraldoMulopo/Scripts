        ttk.Button(f, text="Escolher...", command=self._escolher_saida).pack(
            side="left", padx=(8, 0))

    # -------------------------------------------------------- dispositivos
    def _listar_dispositivos(self):
        try:
            devs = sd.query_devices()
            entrada = [d["name"] for d in devs if d["max_input_channels"] > 0]
            self.combo_dev["values"] = entrada
            if entrada:
                self.combo_dev.current(0)
        except Exception as e:
            self.var_status.set(f"Erro: {e}")

    def _mudar_sample_rate(self, _evt=None):
        self.sample_rate = int(self.combo_sr.get())

    def _saida_padrao(self):
        ext = ".mp3" if self.combo_fmt.get() == "MP3" else ".wav"
        nome = "gravacao_" + time.strftime("%Y%m%d_%H%M%S") + ext
        return os.path.join(MUSICAS, nome)

    def _escolher_saida(self):
        fmt = self.combo_fmt.get()
        ext = ".mp3" if fmt == "MP3" else ".wav"
        p = filedialog.asksaveasfilename(
            title="Guardar gravacao como",
            parent=self,
            defaultextension=ext,
            initialdir=MUSICAS,
            initialfile=os.path.basename(self._saida_padrao()),
            filetypes=[(fmt, f"*{ext}"), ("Todos", "*")])
        if p:
            self.var_saida.set(p)

    # ---------------------------------------------------------- gravacao
    def _toggle_gravar(self):
        if self.gravando:
            self._parar_gravacao()
        else:
            self._iniciar_gravacao()

    def _iniciar_gravacao(self):
        self.frames = []
        self._scroll_offset = 0
        self.gravando = True
        self.btn_gravar.configure(text="Parar", style="Stop.TButton")
        self.btn_salvar.pack_forget()
        self.var_status.set("Gravando...")
        self.var_tempo.set("00:00.0")

        ch = 2 if "Stereo" in self.combo_ch.get() else 1
        self.canais = ch
        sr = int(self.combo_sr.get())

        try:
            self.stream = sd.InputStream(
                samplerate=sr, channels=ch, dtype="float32",
                callback=self._callback_gravar)
            self.stream.start()
            self._inicio = time.time()
            self._atualizar_timer()
            self._atualizar_waveform_live()
        except Exception as e:
            self.gravando = False
            self.btn_gravar.configure(text="Gravar", style="Rec.TButton")
            self.var_status.set(f"Erro: {e}")

    def _callback_gravar(self, indata, frames, time_info, status):
        if self.gravando:
            self.frames.append(indata.copy())

    def _atualizar_timer(self):
        if self.gravando:
            elapsed = time.time() - self._inicio
            mins = int(elapsed // 60)
            secs = elapsed % 60
            self.var_tempo.set(f"{mins:02d}:{secs:05.1f}")
            self.after(100, self._atualizar_timer)

    def _atualizar_waveform_live(self):
        if self.gravando and self.frames:
            self.dados_audio = np.concatenate(self.frames, axis=0)
            self._desenhar_waveform_scroll()
        if self.gravando:
            self.after(60, self._atualizar_waveform_live)

    def _parar_gravacao(self):
        self.gravando = False
        if self.stream:
            self.stream.stop()
            self.stream.close()
            self.stream = None
        self.btn_gravar.configure(text="Gravar", style="Rec.TButton")
        if self.frames:
            self.dados_audio = np.concatenate(self.frames, axis=0)
            duracao = len(self.dados_audio) / self.sample_rate
            self.var_status.set(f"Gravado: {duracao:.1f}s")
            self._desenhar_waveform()
            self.btn_salvar.pack(side="left", padx=(10, 0))
        else:
            self.var_status.set("Gravacao vazia")

    # ---------------------------------------------------------- reproducao
    def _toggle_tocar(self):
        if self.tocando:
            self._parar_tocar()
        elif self.dados_audio is not None:
            self._iniciar_tocar()
        else:
            messagebox.showwarning(APP, "Nenhum audio para tocar.")

    def _iniciar_tocar(self):
        self.tocando = True
        self.btn_tocar.configure(text="Pausar", style="Stop.TButton")
        self.var_status.set("Reproduzindo...")
        threading.Thread(target=self._tocar_thread, daemon=True).start()

    def _tocar_thread(self):
        try:
            sd.play(self.dados_audio, self.sample_rate)
            sd.wait()
        except Exception:
            pass
        finally:
            self.tocando = False
            self.after(0, lambda: self.btn_tocar.configure(text="Tocar", style="Play.TButton"))
            self.after(0, lambda: self.var_status.set("Pronto"))

    def _parar_tocar(self):
        sd.stop()
        self.tocando = False
        self.btn_tocar.configure(text="Tocar", style="Play.TButton")
        self.var_status.set("Pronto")

    def _parar(self):
        if self.gravando:
            self._parar_gravacao()
        if self.tocando:
            self._parar_tocar()

    # --------------------------------------------------------- waveform
    def _desenhar_waveform(self, _evt=None):
        self.canvas.delete("all")
        cw = max(50, self.canvas.winfo_width() - 4)
        ch = max(50, self.canvas.winfo_height() - 4)

        if self.dados_audio is None:
            self.canvas.create_text(cw // 2, ch // 2,
                                     text="Grave audio para ver a forma de onda",
                                     fill=FG_DIM, font=("Sans", 11))
            return

        dados = self.dados_audio.flatten()
        total = len(dados)
        if total == 0:
            return

        pontos_por_px = max(1, total // cw)
        mid = ch // 2

        coords = []
        for x in range(cw):
            ini = int(x * total / cw)
            fim = min(ini + pontos_por_px, total)
            if ini >= total:
                break
            bloco = dados[ini:fim]
            if len(bloco) == 0:
                continue
            v = float(np.mean(bloco))
            y = mid - v * (mid - 4)
            coords.extend([x, y])

        if len(coords) >= 4:
            self.canvas.create_line(coords, fill=ACCENT, width=1.5, smooth=True)
        self.canvas.create_line(0, mid, cw, mid, fill=BORDER, width=1)

    def _desenhar_waveform_scroll(self):
        self.canvas.delete("all")
        cw = max(50, self.canvas.winfo_width() - 4)
        ch = max(50, self.canvas.winfo_height() - 4)
        mid = ch // 2

        dados = self.dados_audio.flatten()
        total = len(dados)
        sr = self.sample_rate

        visivel = int(sr * 4)
        fim = total
        ini = max(0, fim - visivel)

        janela = dados[ini:fim]
        if len(janela) == 0:
            return

        pontos_por_px = max(1, len(janela) // cw)
        coords = []
        for x in range(cw):
            pini = int(x * len(janela) / cw)
            pfim = min(pini + pontos_por_px, len(janela))
            if pini >= len(janela):
                break
            bloco = janela[pini:pfim]
            if len(bloco) == 0:
                continue
            v = float(np.mean(bloco))
            y = mid - v * (mid - 4)
            coords.extend([x, y])

        if len(coords) >= 4:
            self.canvas.create_line(coords, fill=ACCENT, width=1.5, smooth=True)
        self.canvas.create_line(0, mid, cw, mid, fill=BORDER, width=1)

    # ---------------------------------------------------------- salvar
    def _salvar(self):
        if self.dados_audio is None:
            messagebox.showwarning(APP, "Nenhum audio para salvar.")
            return

        path = self.var_saida.get().strip()
        if not path:
            path = self._saida_padrao()

        ext = os.path.splitext(path)[1].lower()
        fmt = self.combo_fmt.get()

        if fmt == "MP3" and ext != ".mp3":
            path = os.path.splitext(path)[0] + ".mp3"
        elif fmt == "WAV" and ext != ".wav":
            path = os.path.splitext(path)[0] + ".wav"

        if os.path.exists(path):
            if not messagebox.askyesno(
                    APP, f"O ficheiro ja existe:\n{path}\n\nSubstituir?",
                    icon="warning"):
                return

        try:
            os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
            if fmt == "MP3":
                self._salvar_mp3(path)
            else:
                self._salvar_wav(path)
            self.var_status.set(f"Salvo: {os.path.basename(path)}")
            self._carregar_historico()
        except Exception as e:
            messagebox.showerror(APP, f"Erro ao salvar:\n{e}")

    def _salvar_wav(self, path):
        dados = (self.dados_audio * 32767).astype(np.int16)
        with wave.open(path, "wb") as wf:
            wf.setnchannels(self.canais)
            wf.setsampwidth(2)
            wf.setframerate(self.sample_rate)
            wf.writeframes(dados.tobytes())

    def _salvar_mp3(self, path):
        tmp_wav = path + ".tmp.wav"
        self._salvar_wav(tmp_wav)
        try:
            subprocess.run([
                "ffmpeg", "-y", "-i", tmp_wav,
                "-codec:a", "libmp3lame", "-b:a", "192k", path
            ], capture_output=True, check=True)
        finally:
            if os.path.exists(tmp_wav):
                os.remove(tmp_wav)

    # ---------------------------------------------------------- historico
    def _carregar_historico(self):
        for item in self.tree.get_children():
            self.tree.delete(item)

        ficheiros = []
        for ext in ("*.wav", "*.mp3"):
            ficheiros.extend(glob.glob(os.path.join(MUSICAS, ext)))
        ficheiros.sort(key=lambda f: os.path.getmtime(f), reverse=True)

        for f in ficheiros[:20]:
            nome = os.path.basename(f)
            data = time.strftime("%Y-%m-%d %H:%M", time.localtime(os.path.getmtime(f)))
            tamanho = os.path.getsize(f)
            if tamanho > 1024 * 1024:
                tam_str = f"{tamanho / (1024*1024):.1f} MB"
            elif tamanho > 1024:
                tam_str = f"{tamanho / 1024:.0f} KB"
            else:
                tam_str = f"{tamanho} B"
            self.tree.insert("", "end", values=(nome, data, tam_str))

    def _tocar_historico(self, _event):
        sel = self.tree.selection()
        if not sel:
            return
        nome = self.tree.item(sel[0])["values"][0]
        caminho = os.path.join(MUSICAS, nome)
        if os.path.exists(caminho):
            try:
                dados, sr = sd.read(caminho)
                self.dados_audio = dados
                self.sample_rate = sr
                self._desenhar_waveform()
                self.var_status.set(f"A reproduzir: {nome}")
                threading.Thread(target=self._tocar_ficheiro, args=(caminho,), daemon=True).start()
            except Exception as e:
                messagebox.showerror(APP, f"Erro ao tocar:\n{e}")

    def _tocar_ficheiro(self, caminho):
        try:
            dados, sr = sd.read(caminho)
            sd.play(dados, sr)
            sd.wait()
        except Exception:
            pass
        finally:
            self.after(0, lambda: self.var_status.set("Pronto"))

    # ------------------------------------------------------------ novo
    def _novo(self):
        if self.gravando:
            self._parar_gravacao()
        if self.tocando:
            self._parar_tocar()
        self.dados_audio = None
        self.frames = []
        self.var_tempo.set("00:00.0")
        self.var_saida.set(self._saida_padrao())
        self.var_status.set("Pronto")
        self.btn_salvar.pack_forget()
        self._desenhar_waveform()


def main():
    app = Recordinn()
    app.mainloop()


if __name__ == "__main__":
    main()
PYEOF
