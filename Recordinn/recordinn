#!/usr/bin/env python3
"""Recordinn — Gravador de Áudio (GUI Tk)."""

import os
import sys
import time
import wave
import glob
import threading
import subprocess
import tkinter as tk
from tkinter import ttk, filedialog, messagebox
import numpy as np

try:
    import sounddevice as sd
except ImportError:
    print("Erro: sounddevice nao instalado.\nInstala com: pip3 install sounddevice")
    sys.exit(1)

APP = "Recordinn"
ACCENT = "#22C55E"
ACCENT_DARK = "#16A34A"
BG = "#0A0A0A"
BG_CARD = "#141414"
BG_INPUT = "#1E1E1E"
FG = "#FAFAFA"
FG_DIM = "#71717A"
FG_ACCENT = "#22C55E"
BORDER = "#27272A"
BLACK = "#000000"
MUSICAS = os.path.expanduser("~/Músicas")
BASE = os.path.expanduser("~/.local/share/recordinn")
GRAVS = os.path.join(BASE, "gravacoes")

os.makedirs(GRAVS, exist_ok=True)
os.makedirs(MUSICAS, exist_ok=True)


class ToolTip:
    def __init__(self, widget, texto):
        self.widget = widget
        self.texto = texto
        self._janela = None
        widget.bind("<Enter>", self._mostrar)
        widget.bind("<Leave>", self._esconder)

    def _mostrar(self, _e=None):
        self._esconder()
        x = self.widget.winfo_rootx() + 16
        y = self.widget.winfo_rooty() + self.widget.winfo_height() + 6
        self._janela = tk.Toplevel(self.widget)
        self._janela.wm_overrideredirect(True)
        self._janela.wm_geometry(f"+{x}+{y}")
        lbl = tk.Label(self._janela, text=self.texto, justify="left",
                       bg="#18181B", fg="#FAFAFA", padx=10, pady=6,
                       font=("Sans", 9))
        lbl.pack()

    def _esconder(self, _e=None):
        if self._janela is not None:
            self._janela.destroy()
            self._janela = None


class Recordinn(tk.Tk):

    def __init__(self):
        super().__init__()
        self.title(APP)
        try:
            self.tk.call("wm", "class", self._w, APP)
        except Exception:
            pass
        self.configure(bg=BG)
        self.minsize(900, 620)

        self.gravando = False
        self.tocando = False
        self.dados_audio = None
        self.sample_rate = 44100
        self.canais = 1
        self.frames = []
        self.stream = None
        self._scroll_offset = 0

        self.var_status = tk.StringVar(value="Pronto")
        self.var_tempo = tk.StringVar(value="00:00.0")
        self.var_formato = tk.StringVar(value="WAV")
        self.var_saida = tk.StringVar()
        self.var_sr = tk.StringVar(value="44100")
        self.var_ch = tk.StringVar(value="1 (Mono)")

        self._estilos()
        self._construir_interface()
        self._centrar(900, 640)
        self._ligar_atalhos()
        self.after(200, self._listar_dispositivos)
        self._carregar_historico()

    def _estilos(self):
