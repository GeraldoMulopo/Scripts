                                      state="readonly", width=10)
        self.combo_sr.set("44100")
        self.combo_sr.pack(anchor="w")
        self.combo_sr.bind("<<ComboboxSelected>>", self._mudar_sample_rate)

        # Canais
        f = ttk.LabelFrame(df, text="CANAIS", padding=10)
        f.pack(fill="x", pady=(0, 10))
        self.combo_ch = ttk.Combobox(f, values=["1 (Mono)", "2 (Stereo)"],
                                      state="readonly", width=12)
        self.combo_ch.set("1 (Mono)")
        self.combo_ch.pack(anchor="w")

        # Formato
        f = ttk.LabelFrame(df, text="FORMATO", padding=10)
        f.pack(fill="x", pady=(0, 10))
        fmts = ["WAV"]
        try:
            subprocess.run(["ffmpeg", "-version"], capture_output=True, timeout=2)
            fmts.append("MP3")
        except Exception:
            pass
        self.combo_fmt = ttk.Combobox(f, values=fmts, state="readonly", width=8)
        self.combo_fmt.set("WAV")
        self.combo_fmt.pack(anchor="w")

        # Guardar em
        f = ttk.LabelFrame(df, text="GUARDAR EM", padding=10)
        f.pack(fill="x", pady=(0, 10))
        self.var_saida.set(self._saida_padrao())
        entry = ttk.Entry(f, textvariable=self.var_saida)
