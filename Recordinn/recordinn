        f = ttk.LabelFrame(df, text="DISPOSITIVO", padding=10)
        f.pack(fill="x", pady=(0, 10))
        self.combo_dev = ttk.Combobox(f, state="readonly", width=50)
        self.combo_dev.pack(fill="x")

        # Sample Rate
        f = ttk.LabelFrame(df, text="SAMPLE RATE", padding=10)
        f.pack(fill="x", pady=(0, 10))
